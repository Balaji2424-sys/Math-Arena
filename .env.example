# Create an Upstash Redis database from the Vercel Marketplace and copy its REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Generate a long random organizer secret. Never commit the real value.
ARENA_ADMIN_TOKEN=

# Optional namespace for this event. Use a new value to start a separate arena history.
ARENA_EVENT_ID=mathfest:event4
